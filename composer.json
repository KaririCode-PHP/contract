{
    "name": "kariricode/contract",
    "description": "Interfaces shared by KaririCode Framework components, so that components depend on contracts instead of on each other. Interfaces only; no runtime dependency beyond PHP.",
    "type": "library",
    "license": "MIT",
    "keywords": ["contract", "interface", "PSRs", "php", "kariri", "framework", "kariricode", "arfa"],
    "homepage": "https://kariricode.org/",
    "authors": [
        {"name": "Walmir Silva", "email": "walmir.silva@kariricode.org"}
    ],
    "support": {
        "issues": "https://github.com/KaririCode-Framework/kariricode-contract/issues",
        "source": "https://github.com/KaririCode-Framework/kariricode-contract"
    },
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {"KaririCode\\Contract\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"KaririCode\\Contract\\Tests\\": "tests/"}
    },
    "scripts": {
        "test": "phpunit",
        "test-inherited": "phpunit --testsuite=inherited",
        "test-unit": "phpunit --testsuite=unit",
        "test-compatibility": "phpunit --testsuite=compatibility",
        "test-conformance": "phpunit --testsuite=conformance",
        "phpstan": "phpstan analyse --no-progress",
        "psalm": "psalm --no-cache",
        "psalm-strict": "psalm -c psalm-strict.xml --no-cache",
        "security": "@composer audit --locked",
        "sbom": "php tools/sbom.php sbom.cdx.json",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "check": ["@cs-check", "@phpstan", "@psalm", "@psalm-strict", "@test"]
    },
    "extra": {
        "arfa": {"version": "1.3", "level": 1},
        "asvs": {"version": "5.0", "level": 1},
        "branch-alias": {"dev-main": "2.x-dev"}
    },
    "config": {"sort-packages": true},
    "minimum-stability": "stable",
    "prefer-stable": true
}
